# Containerfile.secure
# Purpose: secure, compact image for demo-app, used from Step 02 onwards.
# Build context is the repository root: podman build -f 02-secure-images/Containerfile.secure .
# Pattern: multi-stage build on Red Hat UBI9, minimal runtime, non-root user.

# Stage 1 (build): Red Hat Go toolset on UBI9. Pinned minor version: you know
# exactly what you build with, and Red Hat patches it via RHSA.
# In production, pin by digest as well: ubi9/go-toolset:1.25@sha256:<digest>
FROM registry.access.redhat.com/ubi9/go-toolset:1.25 AS builder

# The toolset runs as UID 1001 and only /opt/app-root/src is writable.
WORKDIR /opt/app-root/src
COPY --chown=1001:0 01-12factor-platform/go.mod 01-12factor-platform/main.go ./

# Static binary, stripped of symbols and path info: small, no source in the image.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o demo .

# Stage 2 (runtime): UBI9 micro, the smallest UBI variant. No package manager,
# no compiler. Small image = small attack surface.
FROM registry.access.redhat.com/ubi9/ubi-micro

# The binary only, from the build stage. Owned by UID 1001, group 0 (root group),
# group permissions equal to owner permissions: OpenShift may assign any UID from
# the project range, but that UID always runs with GID 0, so the file stays usable.
COPY --from=builder --chown=1001:0 --chmod=0755 /opt/app-root/src/demo /opt/app/demo

# Never run as root.
USER 1001
EXPOSE 8080
CMD ["/opt/app/demo"]
